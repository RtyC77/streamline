VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
# Opcional: origem HTTPS pública para confirmação de cadastro e recuperação de senha.
# Se vazia, usa a origem em que o StreamLite está aberto.
VITE_AUTH_SITE_URL=
# Opcional. Ative também CAPTCHA no Supabase Auth.
VITE_TURNSTILE_SITE_KEY=
# Ative após publicar a Edge Function register-account e configurar o Turnstile.
VITE_REGISTRATION_FUNCTION=false
# Array JSON. Não coloque credenciais TURN permanentes aqui.
VITE_ICE_SERVERS=[{"urls":"stun:stun.cloudflare.com:3478"}]
# Use relay somente para testar ou exigir TURN. Requer TURN configurado.
VITE_ICE_TRANSPORT_POLICY=all
# Opcional: Edge Function que entrega credenciais TURN temporárias.
VITE_TURN_FUNCTION=
